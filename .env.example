# OpenAI API key for relevance filtering (leave blank to skip AI and auto-approve all articles)
OPENAI_API_KEY=your_openai_api_key_here

# Short URL base (override for local dev)
SHORT_URL_BASE=http://localhost:3000

# Alchemy RPC URL for Polygon blockchain (optional, for game API features)
ALCHEMY_POLYGON_RPC_URL=your_alchemy_api_token_here

# Simulation mode (default off). When true: NFT ownership is read from the
# simulated_nfts table, GET /api/v1/players/:wallet/cards and POST
# /api/v1/auth/simulate are enabled, and no chain access happens (result
# notification skipped, /api/v1/rpc/polygon returns 403). Seed cards with
# `bin/rails "simulation:assign[0xWALLET,10]"`. Never enable in a real deployment.
# SIMULATION_MODE=true
# SIMULATION_COLLECTION=cpigs-collection-879234287   # catalog: config/simulation/collections/<name>.yml

# Comma-separated list of origins allowed to call the API (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# News bot pipeline switches — both default to OFF.
# NEWS_FETCH_ENABLED=true runs the scheduled NewsAPI fetch (30 min cron; every
# run also spends shared OpenAI quota). TELEGRAM_ENABLED=true posts approved
# articles to Telegram. Opt in per environment as needed.
# NEWS_FETCH_ENABLED=true
# TELEGRAM_ENABLED=true

# Note: The following secrets are stored in Rails credentials (config/credentials.yml.enc):
#   - secret_key_base
#   - news_api_key
#   - telegram_bot_token
#
# Edit credentials with: bin/rails credentials:edit
# The master.key file is required to decrypt credentials (never commit it to git).
